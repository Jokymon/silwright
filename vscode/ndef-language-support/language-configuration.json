{
  "comments": {
    "lineComment": "//"
  },
  "folding": {
    "markers": {
      "start": "^\\s*(?:node|trait|choice|enum)\\b",
      "end": "^\\s*end\\b"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:node|trait|choice|enum)\\b.*$",
    "decreaseIndentPattern": "^\\s*end\\b.*$"
  }
}
