module lir

node Number
    number: number
    assigned_type: type
end

node CharLiteral
    ch: character
end

node BoolLiteral
    value: boolean
end

node StringLiteral
    table_index: index
    size: number
end

node IfExpression
    condition: Expr
    then_code: *Expr
    else_code: *Expr
    assigned_type: type
end

node UnaryExpression
    expr: Expr
    assigned_type: type
end

choice Expr
    Number
    | CharLiteral
    | BoolLiteral
    | StringLiteral
    | IfExpression
    | UnaryExpression
end

node FunctionParameter
    name: identifier
end

node FunctionSignature
    parameters: *value FunctionParameter
    function_type: type
end

node FunctionHead
    name: identifier
    signature: value FunctionSignature
end

node FunctionDefinition
    function_head: FunctionHead
    code: *Expr
    // TODO: add 'scope' member
end

