module expressions

node Variable
    name: identifier
end

node Number
    value: number
end

choice Expr
    Variable | Number | BinaryExpression
end

enum Op
    Add | Subtract | Multiply | Divide | Modulus
end

node BinaryExpression
    op: Op
    left: Expr
    right: Expr
end

node FunctionSignature
    return_type: identifier
    parameter_types: *identifier
end

node FunctionHead
    name: identifier
    signature: value FunctionSignature
end

node FunctionDefinition
    head: value FunctionHead
    code: *Expr
end
